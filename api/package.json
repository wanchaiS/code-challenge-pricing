{
  "name": "basic-node-crud",
  "version": "1.0.0",
  "description": "node crud app show case",
  "homepage": "https://github.com/wanchaiS/basic-node-crud#readme",
  "bugs": {
    "url": "https://github.com/wanchaiS/basic-node-crud/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wanchaiS/basic-node-crud.git"
  },
  "license": "ISC",
  "author": "wanchaiS",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "tsx --watch --env-file .env src/index.ts",
    "start": "node --env-file .env dist/index.js",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest --run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tsconfig/node24": "^24.0.2",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.10",
    "@vitest/eslint-plugin": "^1.4.3",
    "eslint": "^9.39.1",
    "eslint-plugin-perfectionist": "^4.15.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.0.10"
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}
